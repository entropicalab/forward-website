---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localized, tr } from '../i18n/utils';
import { services } from '../data/services';

const locale = 'es' as const;
const t = tr(locale);
const list = services[locale];
---

<BaseLayout
  title="servicios · forward energy"
  description="servicios de ingeniería para proyectos de energía renovable en panamá: factibilidad, ingeniería, permisos, construcción, operación, owner's engineer, optimización, PPA y termografía."
  locale={locale}
>
  <section class="page-head has-img" style="--ph-img:url(/img/engineer.jpg)">
    <div class="site-wrap">
      <div class="ph-eb">// servicios</div>
      <h1>De la factibilidad a la <span class="accent">operación.</span></h1>
      <p class="ph-lede">
        Una sola firma para todo el ciclo del proyecto. Nueve áreas de servicio que puede
        contratar de forma independiente o como una entrega integral.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="block-eb">// índice de servicios</div>
      <div class="svc-list" style="margin-top:24px;">
        {list.map((s) => (
          <a class="svc-row svc-link" href={`#${s.slug}`}>
            <span class="idx">{s.num}</span>
            <span class="name">{s.title}</span>
            <span class="desc">{s.lede}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {list.map((s, idx) => (
    <section class:list={['block', 'svc-section', { alt: idx % 2 === 0 }]} id={s.slug}>
      <div class="site-wrap">
        <div class="svc-sec-head">
          <div class="block-eb">// {s.num}</div>
          <h2 class="block-h">{s.title}</h2>
          <p class="block-sub">{s.lede}</p>
        </div>

        <div class="grid-2 svc-scope">
          <div>
            <div class="block-eb">// alcance</div>
            <h3 class="svc-scope-h">Qué incluye.</h3>
          </div>
          <div class="prose"><p>{s.intro}</p></div>
        </div>

        <div class="cap-grid">
          {s.capabilities.map((c, i) => (
            <div class="cap">
              <span class="cap-idx">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.name}</h3>
              <p>{c.body}</p>
            </div>
          ))}
        </div>

        <div class="svc-outcome">
          <span class="svc-outcome-k">Resultado</span>
          <p>{s.outcome}</p>
        </div>
      </div>
    </section>
  ))}

  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <div class="block-eb">// siguiente paso</div>
        <h2 class="closing-h">Hablemos de su proyecto.</h2>
        <div class="closing-ctas">
          <a class="btn accent" href={localized('/contact', locale)}>
            {t('cta.consult')}<span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:admin@forward-nrg.com">admin@forward-nrg.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-link { text-decoration: none; color: inherit; }
  .svc-link .name { transition: color 0.2s; }
  .svc-link:hover .name { color: var(--forest); }

  .svc-section { scroll-margin-top: 88px; }
  .svc-sec-head { max-width: 60ch; margin-bottom: 40px; }
  .svc-scope { align-items: start; }
  .svc-scope-h { font-family: var(--font-display); font-size: clamp(22px, 3vw, 30px); font-weight: 600; letter-spacing: -0.02em; margin: 8px 0 0; }

  .cap-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line-on-paper); border: 1px solid var(--line-on-paper); margin-top: 44px; }
  .cap { background: var(--paper); padding: 28px 30px; display: flex; flex-direction: column; gap: 8px; }
  .alt .cap { background: var(--paper-2); }
  .cap-idx { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; color: var(--green); }
  .cap h3 { font-family: var(--font-display); font-size: 21px; font-weight: 600; letter-spacing: -0.01em; margin: 0; }
  .cap p { font-size: 14.5px; line-height: 1.6; color: var(--mute-on-paper); margin: 0; }
  @media (max-width: 680px) { .cap-grid { grid-template-columns: 1fr; } }

  .svc-outcome { display: flex; gap: 18px; align-items: baseline; margin-top: 32px; padding-left: 18px; border-left: 2px solid var(--green); }
  .svc-outcome-k { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green-ink); flex: none; padding-top: 4px; }
  .svc-outcome p { font-family: var(--font-display); font-size: clamp(18px, 2.2vw, 24px); font-weight: 500; letter-spacing: -0.015em; line-height: 1.3; margin: 0; max-width: 46ch; }
</style>
