---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localized, tr } from '../i18n/utils';
import { services } from '../data/services';

const locale = 'es' as const;
const t = tr(locale);
const list = services[locale];
---

<BaseLayout
  title="servicios · forward energy"
  description="servicios de ingeniería para proyectos de energía renovable en panamá: desarrollo, ingeniería, permisos, construcción, operación y owner's engineer."
  locale={locale}
>
  <section class="page-head has-img" style="--ph-img:url(/img/engineer.jpg)">
    <div class="site-wrap">
      <div class="ph-eb">// servicios</div>
      <h1>De la factibilidad a la <span class="accent">operación.</span></h1>
      <p class="ph-lede">
        Una sola firma para todo el ciclo del proyecto. Seis áreas de servicio que puede
        contratar de forma independiente o como una entrega integral.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="svc-list" style="margin-top:0;">
        {list.map((s) => (
          <a class="svc-row svc-link" href={localized(`/services/${s.slug}`, locale)}>
            <span class="idx">{s.num}</span>
            <span class="name">{s.title}</span>
            <span class="desc">{s.lede}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <div class="block-eb">// siguiente paso</div>
        <h2 class="closing-h">Hablemos de su proyecto.</h2>
        <div class="closing-ctas">
          <a class="btn accent" href={localized('/contact', locale)}>
            {t('cta.consult')}<span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:info@forward-nrg.com">info@forward-nrg.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-link { text-decoration: none; color: inherit; }
  .svc-link .name { transition: color 0.2s; }
  .svc-link:hover .name { color: var(--forest); }
</style>
