---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FORM_ENDPOINT } from '../../config/forms';

const locale = 'en' as const;
---

<BaseLayout
  title="contact · forward energy"
  description="let's talk about your renewable energy project in panama. request a consultation with forward energy."
  locale={locale}
>
  <section class="page-head has-img" style="--ph-img:url(/img/grid.jpg)">
    <div class="site-wrap">
      <div class="ph-eb">// contact</div>
      <h1>Let’s talk about your <span class="accent">project.</span></h1>
      <p class="ph-lede">Tell us what stage you’re at and what you need. We reply within two working days.</p>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="grid-2">
        <div>
          <div class="block-eb">// direct</div>
          <ul class="contact-list">
            <li><span class="cl-k">email</span><a href="mailto:admin@forward-nrg.com">admin@forward-nrg.com</a></li>
            <li><span class="cl-k">location</span><span>Panama City · Panama</span></li>
          </ul>
        </div>

        <div class="form-wrap">
          <form
            class="contact-form"
            method="POST"
            action={FORM_ENDPOINT || undefined}
            data-ajax={FORM_ENDPOINT ? 'true' : 'false'}
            data-error="Could not send. Please try again or email us at admin@forward-nrg.com."
          >
            <input type="hidden" name="_subject" value="New contact — forward-nrg.com" />
            {/* honeypot: bots fill this, humans don't — formspree drops these */}
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

            <div class="field"><label for="name">Name</label><input id="name" name="name" type="text" required /></div>
            <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required /></div>
            <div class="field"><label for="company">Company (optional)</label><input id="company" name="company" type="text" /></div>
            <div class="field-row">
              <div class="field">
                <label for="type">Project type</label>
                <select id="type" name="project_type">
                  <option value="" selected>Select one</option>
                  <option value="solar">Solar</option>
                  <option value="wind">Wind</option>
                  <option value="storage">Storage</option>
                  <option value="other">Other / Not sure</option>
                </select>
              </div>
              <div class="field"><label for="location">Project location</label><input id="location" name="location" type="text" placeholder="Province, Panama" /></div>
            </div>
            <div class="field"><label for="brief">Tell us about the project</label><textarea id="brief" name="message" required></textarea></div>

            <button class="btn accent" type="submit">Send<span class="arrow-tail" aria-hidden="true"></span></button>
            <p class="form-status" role="alert" hidden></p>
            {!FORM_ENDPOINT && <p class="form-note">The form isn’t connected yet. For now, email us at <a href="mailto:admin@forward-nrg.com">admin@forward-nrg.com</a>.</p>}
          </form>

          <div class="form-success" hidden>
            <span class="material-symbols-outlined icon-md fs-check">check_circle</span>
            <h3>Message received.</h3>
            <p>Thanks for reaching out. We’ll get back to you within two working days.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLFormElement>('.contact-form[data-ajax="true"]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form-status');
    const success = form.parentElement?.querySelector<HTMLElement>('.form-success');
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (status) { status.hidden = true; status.textContent = ''; }
      if (btn) btn.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.hidden = true;
          if (success) success.hidden = false;
          success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error('bad status');
        }
      } catch {
        if (status) { status.hidden = false; status.textContent = form.dataset.error || 'Error.'; }
        if (btn) btn.disabled = false;
      }
    });
  });
</script>

<style>
  .contact-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 20px; }
  .contact-list li { display: flex; flex-direction: column; gap: 4px; font-size: 17px; }
  .cl-k { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute-on-paper-2); }
  .contact-list a:hover { color: var(--forest); }
  .contact-form { display: flex; flex-direction: column; gap: 18px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 540px) { .field-row { grid-template-columns: 1fr; } }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .form-note { font-size: 13px; color: var(--mute-on-paper); margin: 4px 0 0; }
  .form-note a { color: var(--forest); border-bottom: 1px solid currentColor; }
  .form-status { font-size: 14px; color: #b0492f; margin: 0; }
  .form-success:not([hidden]) { display: flex; flex-direction: column; gap: 10px; padding: 36px 0; }
  .fs-check { color: var(--green); }
  .form-success h3 { font-family: var(--font-display); font-size: 26px; font-weight: 600; letter-spacing: -0.02em; margin: 0; }
  .form-success p { font-size: 16px; color: var(--mute-on-paper); margin: 0; max-width: 46ch; }
</style>
