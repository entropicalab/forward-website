---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localized, tr } from '../../i18n/utils';
import { services } from '../../data/services';

const locale = 'en' as const;
const t = tr(locale);
const list = services[locale];
---

<BaseLayout
  title="services · forward energy"
  description="engineering services for renewable energy projects in panama: development, engineering, permitting, construction, operations and owner's engineer."
  locale={locale}
>
  <section class="page-head has-img" style="--ph-img:url(/img/engineer.jpg)">
    <div class="site-wrap">
      <div class="ph-eb">// services</div>
      <h1>From feasibility to <span class="accent">operation.</span></h1>
      <p class="ph-lede">
        One firm for the whole project lifecycle. Six service areas you can engage on their
        own or as one end-to-end delivery.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="svc-list" style="margin-top:0;">
        {list.map((s) => (
          <a class="svc-row svc-link" href={localized(`/services/${s.slug}`, locale)}>
            <span class="idx">{s.num}</span>
            <span class="name">{s.title}</span>
            <span class="desc">{s.lede}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <div class="block-eb">// next step</div>
        <h2 class="closing-h">Let’s talk about your project.</h2>
        <div class="closing-ctas">
          <a class="btn accent" href={localized('/contact', locale)}>
            {t('cta.consult')}<span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:admin@forward-nrg.com">admin@forward-nrg.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-link { text-decoration: none; color: inherit; }
  .svc-link .name { transition: color 0.2s; }
  .svc-link:hover .name { color: var(--forest); }
</style>
