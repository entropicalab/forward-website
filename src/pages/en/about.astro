---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localized, tr } from '../../i18n/utils';

const locale = 'en' as const;
const t = tr(locale);
---

<BaseLayout
  title="about · forward energy"
  description="forward energy is a panama-based engineering and services firm for renewable energy projects. experience, judgment and clarity."
  locale={locale}
>
  <section class="page-head has-img" style="--ph-img:url(/img/panama.jpg)">
    <div class="site-wrap">
      <div class="ph-eb">// about</div>
      <h1>Experience, judgment and <span class="accent">clarity.</span></h1>
      <p class="ph-lede">
        Forward Energy is a Panama-based engineering and services firm for renewable
        generation projects. We support developers, owners, governments and funds at every
        stage — from feasibility to operation.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="grid-2">
        <div>
          <div class="block-eb">// the firm</div>
          <h2 class="block-h">We move projects forward.</h2>
        </div>
        <div class="prose">
          <p>
            The name says it: forward. We move projects that often stall on permits, technical
            uncertainty or investment decisions. We don’t promise to save the planet; we solve
            what it takes to make renewable energy work in the real world.
          </p>
          <p class="muted">
            We work with technical judgment and clear answers. Every claim has data and
            engineering behind it — no empty green promises.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="site-wrap">
      <div class="block-eb">// leadership</div>
      <div class="founder">
        <div class="founder-photo">
          <img src="/img/ivan-barria.jpg" alt="Iván Barría, founder of Forward Energy" width="853" height="1280" loading="lazy" />
        </div>
        <div class="founder-body">
          <h2 class="block-h" style="margin-bottom:2px;">Iván Barría</h2>
          <div class="founder-role">Founder</div>
          <p class="founder-lead">
            More than two decades leading energy and business transformation in Panama and the
            region. Former CEO of the national transmission company, where he learned that the
            sector’s hard problems aren’t solved by a single brilliant idea, but by seeing the whole
            system and moving the right levers, in the right order.
          </p>
          <ul class="founder-cv">
            <li><span class="fc-k">Former CEO · ETESA</span><span class="fc-v">Led the national transmission company (500 employees): doubled EBITDA in three years and prepared its first international bond issue of USD 500 MM.</span></li>
            <li><span class="fc-k">Energy crisis</span><span class="fc-v">Drove Panama’s spot energy price down from USD 217 to USD 67 per MWh in a year, saving close to USD 600 MM in subsidies.</span></li>
            <li><span class="fc-k">Regional integration</span><span class="fc-v">President of EPR (the SIEPAC line) in 2015: introduced the sale of transmission rights and established the fiber-optic links from Panama to Guatemala.</span></li>
            <li><span class="fc-k">Private sector</span><span class="fc-v">Founded and chaired the Energy Commission of Panama’s Chamber of Commerce. Today he develops a pipeline of wind and solar projects across the region.</span></li>
            <li><span class="fc-k">Education</span><span class="fc-v">Engineering (Villanova) · MBA (INCAE) · Senior Management Program (IPADE).</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="block-eb">// why panama</div>
      <h2 class="block-h">We know the ground and the <span class="accent">regulation.</span></h2>
      <p class="block-sub">
        Panama’s regulatory environment — ASEP, interconnection, environmental permitting —
        is one of the main hurdles for renewable projects. That’s exactly where we add the
        most value: we navigate that process so your project reaches operation.
      </p>
    </div>
  </section>

  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <div class="block-eb">// let’s work together</div>
        <h2 class="closing-h">An experienced brand that looks forward.</h2>
        <div class="closing-ctas">
          <a class="btn accent" href={localized('/contact', locale)}>
            {t('cta.contact')}<span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:admin@forward-nrg.com">admin@forward-nrg.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
