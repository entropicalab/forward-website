---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import BrandMark from '../../components/BrandMark.astro';
import TriMark from '../../components/TriMark.astro';
import { getCollection } from 'astro:content';
import { localized, tr } from '../../i18n/utils';

const locale = 'en' as const;
const t = tr(locale);

const featured = (await getCollection('projects', ({ data }) => data.locale === locale && data.featured && !data.comingSoon))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const lifecycle = ['Development', 'Engineering', 'Permitting', 'Construction', 'Commissioning', 'Operation'];

const cred = [
  { k: 'Track record', v: 'Over a decade', d: 'of energy projects that actually get built and operated.' },
  { k: 'Leadership', v: 'State level', d: 'leadership experience at the highest level of the country’s power sector.' },
  { k: 'Scope', v: 'Idea to operation', d: 'a single firm across the full lifecycle of the project.' },
];

const values = [
  { n: '01', h: 'Experienced', p: 'A track record and engineering rigor behind every recommendation. We know ASEP and Panama’s interconnection processes.' },
  { n: '02', h: 'Clear', p: 'We explain without overwhelming. The technical gets translated, not hidden behind jargon. We write to be understood by a busy investor.' },
  { n: '03', h: 'Honest', p: 'No empty green promises. Every claim has data and engineering behind it. We’ll tell you if a project isn’t viable.' },
  { n: '04', h: 'Close', p: 'We treat your capital and your land as if they were our own. Accessible and human, within professional respect.' },
];

const services = [
  { i: '01', name: 'Feasibility & interconnection', desc: 'Technical viability and grid connection' },
  { i: '02', name: 'Engineering & design', desc: 'Electrical, civil and energy modeling' },
  { i: '03', name: 'Permitting & approvals', desc: 'Regulatory management and filings' },
  { i: '04', name: 'Construction management', desc: 'Quality, cost and schedule oversight' },
  { i: '05', name: 'Operations & maintenance', desc: 'On-site service across the asset life' },
  { i: '06', name: 'Owner’s engineer', desc: 'Independent engineering for the capital' },
  { i: '07', name: 'Asset optimization', desc: 'More yield, including BESS integration' },
  { i: '08', name: 'Power purchase agreements', desc: 'PPA structuring' },
];

const audiences = [
  { i: '01', icon: 'verified', h: 'Investors & funds', p: 'Bankable due diligence and independent judgment. We cut regulatory and technical risk before you commit capital.' },
  { i: '02', icon: 'home_work', h: 'Landowners', p: 'Fair, transparent segmentation of your land, designed to yield the maximum output over twenty years.' },
  { i: '03', icon: 'factory', h: 'Large energy users', p: 'Bespoke PPAs, self-generation and reliable maintenance. Energy as an asset, free of surprises.' },
];

const sectors = [
  { icon: 'solar_power', img: '/img/solar.jpg', h: 'Utility-scale solar', p: 'Grid-connected generation plants, from feasibility to operation.' },
  { icon: 'wind_power', img: '/img/turbinefield.jpg', h: 'Wind', p: 'Resource assessment, engineering and project management for wind.' },
  { icon: 'home_work', img: '/img/rooftop.jpg', h: 'Distributed solar', p: 'On-site generation for commercial and industrial clients.' },
  { icon: 'factory', img: '/img/aerial.jpg', h: 'Industrial solutions', p: 'Efficiency and self-generation for large energy consumers.' },
  { icon: 'battery_charging_full', img: '/img/storage.jpg', h: 'Storage', p: 'Battery integration for firmness and demand management.' },
  { icon: 'verified', img: '/img/engineer.jpg', h: 'Owner’s engineer', p: 'Independent engineering for investors and lenders.' },
];

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'forward energy',
  description: 'engineering and services firm for renewable energy projects in panama.',
  url: 'https://forward-nrg.com/en',
  email: 'admin@forward-nrg.com',
  areaServed: { '@type': 'Country', name: 'Panama' },
  knowsLanguage: ['es', 'en'],
};
---

<BaseLayout
  title="forward energy · engineering for renewable energy projects in panama"
  description="forward energy is a Panamanian engineering and services firm for renewable energy projects — judgment and clarity, from feasibility to operation."
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

  <section class="hero">
    <BrandMark />
    <div class="site-wrap">
      <div class="hero-inner">
        <div class="hero-eb">// renewable energy · panama · idea to operation</div>
        <h1 class="hero-h">Engineering judgment for Panama’s complex <span class="accent">energy grid.</span></h1>
      </div>
      <p class="hero-lede">
        For over a decade, Forward Energy has designed, built and optimized high-yield renewable
        projects. We pair regulatory foresight with creative engineering to turn a complex grid
        into predictable, long-term assets.
      </p>
      <div class="hero-ctas">
        <a class="btn accent" href={localized('/contact', locale)}>
          {t('cta.consult')}<span class="arrow-tail" aria-hidden="true"></span>
        </a>
        <a class="btn" href={localized('/services', locale)}>{t('cta.viewServices')}</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="block-eb">// why Forward</div>
      <h2 class="block-h">Agile specialists, with institutional-grade authority.</h2>
      <p class="block-sub">We don’t win by being the loudest in the room — we win by being the clearest in a complex regulatory landscape.</p>
      <div class="cred-band">
        {cred.map((c) => (
          <div class="cred-cell">
            <span class="cred-k">{c.k}</span>
            <span class="cred-v">{c.v}</span>
            <span class="cred-d">{c.d}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="lifecycle">
    <div class="site-wrap">
      <div class="block-eb">// project lifecycle</div>
      <div class="lifecycle-steps">
        {lifecycle.map((step, idx) => (
          <div class="lc-step">
            <span class="lc-idx">{String(idx + 1).padStart(2, '0')}</span>
            <span class="lc-name">{step}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block dark">
    <div class="site-wrap">
      <div class="block-eb">// how we work</div>
      <h2 class="block-h">Certainty of execution, not green promises.</h2>
      <div class="vcards">
        {values.map((v) => (
          <div class="vcard">
            <span class="vc-num">{v.n}</span>
            <h3>{v.h}</h3>
            <p>{v.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block dark" style="border-top:1px solid var(--line-on-ink);">
    <div class="site-wrap">
      <div class="block-eb">// judgment in action</div>
      <div class="grid-2" style="align-items:center;">
        <div>
          <TriMark width={64} />
          <h2 class="block-h" style="margin-top:20px;">The standard permit leaves <span class="accent">energy on the table.</span></h2>
          <p class="block-sub" style="margin-bottom:18px;">
            Many solar plants in Panama are designed strictly around peak solar hours, leaving
            capacity unused because of standard permit limits. By integrating storage (BESS), that
            surplus is captured and dispatched off-peak — under the same permit.
          </p>
          <p class="block-sub" style="color:var(--on-ink);">
            That’s the difference between standard engineering and judgment. We’ll gladly look at
            your project’s hidden capacity.
          </p>
          <div style="margin-top:28px;">
            <a class="btn accent" href={localized('/services/optimization', locale)}>
              Asset optimization<span class="arrow-tail" aria-hidden="true"></span>
            </a>
          </div>
        </div>
        <div class="proof-metric">
          <span class="pm-num">≈2×</span>
          <span class="pm-label">potential capacity utilization of the asset, without renegotiating the permit</span>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="block-eb">// what we do</div>
      <h2 class="block-h">Services for the entire <span class="accent">project lifecycle.</span></h2>
      <p class="block-sub">A single firm from feasibility through long-term operation.</p>
      <div class="svc-list">
        {services.map((s) => (
          <div class="svc-row">
            <span class="idx">{s.i}</span>
            <span class="name">{s.name}</span>
            <span class="desc">{s.desc}</span>
          </div>
        ))}
      </div>
      <div style="margin-top:40px;">
        <a class="btn" href={localized('/services', locale)}>
          {t('cta.viewServices')}<span class="arrow-tail" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="site-wrap">
      <div class="block-eb">// who we serve</div>
      <h2 class="block-h">Your project, from your point of view.</h2>
      <p class="block-sub">We adjust the focus to who’s deciding — but the judgment is the same.</p>
      <div class="aud-grid">
        {audiences.map((a) => (
          <div class="aud-card">
            <Icon name={a.icon} class="aud-icon" size={30} />
            <span class="aud-i">{a.i}</span>
            <h3>{a.h}</h3>
            <p>{a.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="block-eb">// sectors</div>
      <h2 class="block-h">Where we work.</h2>
      <div class="imgcard-grid">
        {sectors.map((s) => (
          <div class="imgcard" style={`--card-img:url(${s.img})`}>
            <Icon name={s.icon} class="ic-icon" size={32} />
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="media-band" style="--band-img:url(/img/panama.jpg)">
    <div class="site-wrap">
      <div class="mb-inner">
        <div class="block-eb">// panama</div>
        <h2>We connected another plant to the grid. No grand headlines.</h2>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="block-eb">// projects</div>
      <h2 class="block-h">Featured projects.</h2>
      {featured.length > 0 ? (
        <div class="proj-grid">
          {featured.map((p) => (
            <a class="proj-card" href={localized(`/projects/${p.data.slug}`, locale)}>
              <div class="proj-photo">{p.data.heroImage && <img src={p.data.heroImage} alt={p.data.title} loading="lazy" />}</div>
              {p.data.metric && (
                <div class="proj-metric">
                  <span class="proj-num">{p.data.metric.value}<span class="unit">{p.data.metric.unit}</span></span>
                  <span class="proj-mlabel">{p.data.metric.label}</span>
                </div>
              )}
              <div>
                <div class="proj-title">{p.data.title}</div>
                <div class="proj-meta"><span>{p.data.location}</span><span class="sep">·</span><span>{p.data.year}</span></div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <img src="/forward-mark.png" alt="" />
          <p>We’re documenting our project portfolio. In the meantime, we’d be glad to tell you what we’ve brought to operation in Panama — get in touch.</p>
          <a class="btn" href={localized('/contact', locale)}>{t('cta.contact')}</a>
        </div>
      )}
    </div>
  </section>

  <section class="closing-cta">
    <div class="site-wrap">
      <div class="closing-inner">
        <div class="block-eb">// let’s get to work</div>
        <h2 class="closing-h">Have a renewable project in mind?</h2>
        <div class="closing-ctas">
          <a class="btn accent" href={localized('/contact', locale)}>
            {t('cta.contact')}<span class="arrow-tail" aria-hidden="true"></span>
          </a>
          <a class="contact-line" href="mailto:admin@forward-nrg.com">admin@forward-nrg.com</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
