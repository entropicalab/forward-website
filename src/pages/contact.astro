---
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = 'es' as const;

// to make the form deliver email: create a form at https://formspree.io
// (or similar static-form service) and paste its endpoint below.
const FORM_ENDPOINT = ''; // e.g. 'https://formspree.io/f/xxxxxxx'
---

<BaseLayout
  title="contacto · forward energy"
  description="hablemos de su proyecto de energía renovable en panamá. solicite una consulta con forward energy."
  locale={locale}
>
  <section class="page-head">
    <div class="site-wrap">
      <div class="ph-eb">// contacto</div>
      <h1>Hablemos de su <span class="accent">proyecto.</span></h1>
      <p class="ph-lede">Cuéntenos en qué etapa está y qué necesita. Respondemos en un máximo de dos días hábiles.</p>
    </div>
  </section>

  <section class="block">
    <div class="site-wrap">
      <div class="grid-2">
        <div>
          <div class="block-eb">// directo</div>
          <ul class="contact-list">
            <li><span class="cl-k">correo</span><a href="mailto:info@forward-nrg.com">info@forward-nrg.com</a></li>
            <li><span class="cl-k">ubicación</span><span>Ciudad de Panamá · Panamá</span></li>
          </ul>
        </div>

        <form class="contact-form" method="POST" action={FORM_ENDPOINT || undefined}>
          <div class="field"><label for="name">Nombre</label><input id="name" name="name" type="text" required /></div>
          <div class="field"><label for="email">Correo</label><input id="email" name="email" type="email" required /></div>
          <div class="field"><label for="company">Empresa (opcional)</label><input id="company" name="company" type="text" /></div>
          <div class="field"><label for="brief">Cuéntenos sobre el proyecto</label><textarea id="brief" name="brief" required></textarea></div>
          <button class="btn accent" type="submit">Enviar<span class="arrow-tail" aria-hidden="true"></span></button>
          {!FORM_ENDPOINT && <p class="form-note">El formulario aún no está conectado. Por ahora, escríbanos a <a href="mailto:info@forward-nrg.com">info@forward-nrg.com</a>.</p>}
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 20px; }
  .contact-list li { display: flex; flex-direction: column; gap: 4px; font-size: 17px; }
  .cl-k { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute-on-paper-2); }
  .contact-list a:hover { color: var(--forest); }
  .contact-form { display: flex; flex-direction: column; gap: 18px; }
  .form-note { font-size: 13px; color: var(--mute-on-paper); margin: 4px 0 0; }
  .form-note a { color: var(--forest); border-bottom: 1px solid currentColor; }
</style>
